#!/bin/sh
# Capture a quick Wi-Fi/network diagnostic snapshot before the problem recovers.

umask 077
IFACE=${IFACE:-wlp0s20f3}
ROUTER=${ROUTER:-10.0.0.1}
TARGET=${TARGET:-1.1.1.1}
LOGDIR=${LOGDIR:-$HOME/.local/share/wifi-diag}
TS=$(date '+%Y%m%d-%H%M%S')
OUT="$LOGDIR/wifi-diag-$TS.log"

mkdir -p "$LOGDIR" || exit 1

run() {
    printf '\n===== %s =====\n' "$*"
    "$@" 2>&1
    rc=$?
    printf '%s\n' "----- rc=$rc -----"
}

run_sh() {
    title=$1
    shift
    printf '\n===== %s =====\n' "$title"
    sh -c "$*" 2>&1
    rc=$?
    printf '%s\n' "----- rc=$rc -----"
}

can_sudo() {
    command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null
}

run_root() {
    title=$1
    shift
    printf '\n===== %s =====\n' "$title"
    if can_sudo; then
        sudo -n "$@" 2>&1
    else
        "$@" 2>&1
    fi
    rc=$?
    printf '%s\n' "----- rc=$rc -----"
}

run_root_sh() {
    title=$1
    shift
    printf '\n===== %s =====\n' "$title"
    if can_sudo; then
        sudo -n sh -c "$*" 2>&1
    else
        sh -c "$*" 2>&1
    fi
    rc=$?
    printf '%s\n' "----- rc=$rc -----"
}

{
    echo "wifi-diag snapshot"
    echo "timestamp_local=$(date '+%Y-%m-%d %H:%M:%S %z')"
    echo "timestamp_utc=$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    echo "host=$(hostname)"
    echo "iface=$IFACE router=$ROUTER target=$TARGET"
    echo "user=$(id)"
    if can_sudo; then
        echo "sudo=available_noninteractive"
    else
        echo "sudo=unavailable_or_requires_password"
    fi

    run uname -a
    run uptime

    run_root "rfkill" rfkill list
    run ip -br link
    run ip -br addr
    run ip route
    run_sh "resolv.conf" "cat /etc/resolv.conf 2>/dev/null || true"

    run iw dev "$IFACE" link
    run iw dev "$IFACE" get power_save
    run_root "iw station dump" iw dev "$IFACE" station dump

    run_sh "power supply / charger state" "for d in /sys/class/power_supply/*; do echo ===\$d; for f in type online status capacity scope voltage_now current_now power_now charge_now model_name manufacturer; do [ -r \"\$d/\$f\" ] && printf '%s=' \"\$f\" && cat \"\$d/\$f\"; done; done"
    run_sh "intel wifi module power params" "for f in /sys/module/iwlwifi/parameters/power_save /sys/module/iwlwifi/parameters/power_level /sys/module/iwlwifi/parameters/uapsd_disable /sys/module/iwlmvm/parameters/power_scheme; do [ -r \"\$f\" ] && echo -n \"\$f=\" && cat \"\$f\"; done"
    run_sh "wifi PCI runtime PM" "for f in /sys/bus/pci/devices/0000:00:14.3/power/control /sys/bus/pci/devices/0000:00:14.3/power/runtime_status /sys/bus/pci/devices/0000:00:14.3/power/runtime_suspended_time /sys/bus/pci/devices/0000:00:14.3/power/runtime_active_time; do [ -r \"\$f\" ] && echo -n \"\$f=\" && cat \"\$f\" 2>/dev/null; done"

    run_sh "interface counters" "grep -H . /sys/class/net/'$IFACE'/statistics/* 2>/dev/null | sed 's#.*/##' || true"

    run_sh "processes" "ps -eo pid,ppid,stat,etime,args | grep -Ei 'wpa_supplicant|dhcpcd|wifi-watchdog|tlp|power-profiles|upower|powertop' | grep -v grep || true"

    run_root "runit service status" sv status wifi-watchdog wpa_supplicant dhcpcd

    run timeout 8 ping -n -I "$IFACE" -c 3 -W 2 "$ROUTER"
    run timeout 8 ping -n -I "$IFACE" -c 3 -W 2 "$TARGET"
    run timeout 8 ping -n -I "$IFACE" -c 2 -W 2 example.com

    run_sh "ARP/neigh" "ip neigh show dev '$IFACE' 2>/dev/null || true"

    run_root "wpa_cli status" timeout 8 wpa_cli -i "$IFACE" status
    run_root "wifi-watchdog log tail" tail -100 /var/log/wifi-watchdog.log
    run_root "wpa_supplicant log tail" tail -100 /var/log/wpa_supplicant/current
    run_root "dhcpcd log tail" tail -100 /var/log/dhcpcd/current
    run_root_sh "kernel Wi-Fi and suspend/resume events" 'messages=$(dmesg 2>&1); rc=$?; if [ "$rc" -ne 0 ]; then printf "%s\n" "$messages"; exit "$rc"; fi; printf "%s\n" "$messages" | grep -Ei "PM:|suspend|resume|wlp|wlan|iwlwifi|deauth|disassoc|firmware|wifi" | tail -160'

    run_sh "pingstat recent summary" "test -x '$HOME/.local/bin/pingstat' && '$HOME/.local/bin/pingstat' show --last 30m 2>/dev/null || true"

    echo
    echo "saved=$OUT"
} > "$OUT" 2>&1

cat "$OUT"
printf '\nSaved diagnostic snapshot to: %s\n' "$OUT" >&2
